{
  "name": "@lattice-kernel/tooling",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "echo 'lint via root'",
    "test": "vitest run",
    "bench": "node dist/bench/run.js"
  },
  "dependencies": {
    "@lattice-kernel/schemas": "workspace:*",
    "@lattice-kernel/runtime": "workspace:*",
    "@lattice-kernel/policy-engine": "workspace:*",
    "@lattice-kernel/audit": "workspace:*",
    "@lattice-kernel/memory": "workspace:*",
    "@lattice-kernel/crypto": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
