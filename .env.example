# Lattice Kernel Control Plane Configuration

# Server port (default: 3100)
PORT=3100

# SQLite database path (default: ./lattice-control-plane.db)
DB_PATH=./lattice-control-plane.db

# API keys for authentication (comma-separated, empty = auth disabled)
# API_KEYS=key1,key2,key3

# Rate limit: max requests per minute per IP (0 = disabled)
# RATE_LIMIT=100

# For Anthropic adapter
# ANTHROPIC_API_KEY=sk-ant-...

# For OpenAI adapter
# OPENAI_API_KEY=sk-...
